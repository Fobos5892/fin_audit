{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON"
      }
    },
    {
      "name": "windows-mingw-release",
      "displayName": "Windows MinGW Qt 6.11 Release",
      "description": "Qt 6.11.1 + MinGW 13.1 + Ninja (Release)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/mingw_64",
        "CMAKE_C_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/Qt/Tools/Ninja/ninja.exe"
      },
      "environment": {
        "PATH": "C:/Qt/Tools/mingw1310_64/bin;C:/Qt/6.11.1/mingw_64/bin;C:/Qt/Tools/Ninja;$penv{PATH}"
      },
      "vendor": {
        "qt.io/QtCreator/1.0": {
          "preferredKitVendorIds": ["qt.qt6.6111.win64_mingw"]
        }
      }
    },
    {
      "name": "windows-mingw-debug",
      "displayName": "Windows MinGW Qt 6.11 Debug",
      "description": "Qt 6.11.1 + MinGW 13.1 + Ninja (Debug)",
      "inherits": "windows-mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC2022 Qt 6.11 Release",
      "description": "Qt 6.11.1 + MSVC 2022 + Ninja (Release)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/msvc2022_64",
        "CMAKE_MAKE_PROGRAM": "C:/Qt/Tools/Ninja/ninja.exe"
      },
      "environment": {
        "PATH": "C:/Qt/6.11.1/msvc2022_64/bin;C:/Qt/Tools/Ninja;$penv{PATH}"
      }
    },
    {
      "name": "default",
      "displayName": "Default (MinGW Release)",
      "inherits": "windows-mingw-release",
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-mingw-release",
      "configurePreset": "windows-mingw-release",
      "targets": ["FamilyBudget", "all"]
    },
    {
      "name": "windows-mingw-debug",
      "configurePreset": "windows-mingw-debug",
      "targets": ["FamilyBudget", "all"]
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "targets": ["FamilyBudget", "all"]
    },
    {
      "name": "default",
      "configurePreset": "default",
      "targets": ["FamilyBudget", "all"]
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-mingw-release",
      "configurePreset": "windows-mingw-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
